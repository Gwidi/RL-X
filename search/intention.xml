<mujoco model="silver_badger_search">
  <!-- Robot dynamics and contact pairs come from the RL model.
       Mirror the runtime overrides made by LocomotionEnv below. -->
  <include file="../rl_x/environments/custom_mujoco/robot_locomotion/robots/silver_badger/data/plane.xml"/>
  <compiler assetdir="../rl_x/environments/custom_mujoco/robot_locomotion/robots/silver_badger/data/assets"/>
  <option timestep="0.005" iterations="100" ls_iterations="50">
    <flag eulerdamp="enable"/>
  </option>
</mujoco>
